# Copy to .env and fill in with scripts/generate-secrets.sh. Never commit .env.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 32 random bytes, base64. Encrypts e-mail addresses, TOTP secrets and group titles at rest.
VEIL_FIELD_ENCRYPTION_KEY=
# 32 random bytes, base64. Keys the blind index used for e-mail uniqueness lookups.
VEIL_BLIND_INDEX_KEY=
# Random string mixed into IP-address hashes in audit and token records.
VEIL_IP_HASH_SALT=
# PKCS#8 PEM of an ECDSA P-256 private key (ES256 access-token signing). Keep newlines as \n or quote the value.
VEIL_JWT_SIGNING_KEY_PEM=

# Optional
VEIL_DOMAIN=localhost
VEIL_OPENAPI_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
